{
    "manifest_version": 3,
    "name": "Calmly AI - Conflict Mediator",
    "version": "0.3.2",
    "description": "Analyze and rewrite your messages to prevent conflict. Supports Groq, OpenAI, Mistral, and more.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*",
        "https://*.slack.com/*",
        "https://discord.com/*",
        "https://*.telegram.org/*",
        "https://messenger.com/*",
        "https://www.messenger.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://teams.microsoft.com/*",
        "https://notion.so/*",
        "https://www.notion.so/*",
        "http://localhost:5000/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "file:///*",
        "https://api.groq.com/*",
        "https://api.openai.com/*",
        "https://api.mistral.ai/*",
        "https://openrouter.ai/*",
        "https://api.together.xyz/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Calmly AI",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "analyze-text": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Analyze current text with Calmly AI"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "inject.css"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}